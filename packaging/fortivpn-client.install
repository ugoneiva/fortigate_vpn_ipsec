# fortivpn-daemon is a long-running root D-Bus/systemd service. pacman only
# replaces the binary on disk: the process already running keeps serving
# ApplyProfile with the previous release's config generation, so a new
# version appears installed while its fixes never actually run. Stopping it
# is enough — it is D-Bus activated and restarts on the next call, using the
# new binary.
_stop_helper() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  if systemctl is-active --quiet fortivpn-daemon.service 2>/dev/null; then
    echo ":: stopping fortivpn-daemon; it reactivates on demand with the new binary"
    systemctl stop fortivpn-daemon.service >/dev/null 2>&1 || true
  fi
}

post_install() {
  _stop_helper
}

post_upgrade() {
  _stop_helper
}

post_remove() {
  systemctl daemon-reload >/dev/null 2>&1 || true
}
